# Crawl behavior
HEADLESS=1
MAX_REQUESTS=50
CONCURRENCY=3
RESPECT_ROBOTS=1

# Rental filters
MIN_BEDS=3
MIN_BATHS=1
MAX_RENT=4500

# Sale / buy filters
SALE_MIN_BEDS=2
SALE_MIN_BATHS=1
MAX_SALE_PRICE=1500000

# Rental seed URLs (use URLs you're allowed to crawl)
ZILLOW_START_URLS=
STREETEASY_START_URLS=
CRAIGSLIST_START_URLS=

# Sale / buy seed URLs
ZILLOW_SALE_START_URLS=
STREETEASY_SALE_START_URLS=
CRAIGSLIST_SALE_START_URLS=

# Local proxy count (auto-started on server/run, set 0 to disable)
PROXY_COUNT=5
# Override with external proxies (comma-separated); skips auto-start
# PROXY_URLS=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080

# Optional: where to post alerts
DISCORD_WEBHOOK_URL=
